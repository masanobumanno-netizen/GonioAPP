# Generate a random 32-byte hex string locally. Never commit the real .env.
GONIO_SETUP_TOKEN=
# Dropbox scoped App Folder app: files.content.write / files.metadata.read
DROPBOX_APP_KEY=
# Public HTTPS reverse proxy URL pointing to the shared server callback.
DROPBOX_REDIRECT_URI=https://your-server.example/dropbox/callback
# On each Windows PC, set this environment variable before launching the bridge.
GONIO_SHARED_URL=https://your-server.example/
